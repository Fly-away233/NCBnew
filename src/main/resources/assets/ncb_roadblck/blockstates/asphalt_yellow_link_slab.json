{
  "multipart": [
    {"when": {"type": "bottom"}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_bottom_o"}},
    {"when": {"type": "top"},    "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_top_o"}},
    {"when": {"type": "double"}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_o"}},

    {"when": {"type": "bottom", "north": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_bottom_n"}},
    {"when": {"type": "top",    "north": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_top_n"}},
    {"when": {"type": "double", "north": false}, "apply": {"model": "ncb_roadblck:block/asphalt_white_link_n"}},

    {"when": {"type": "bottom", "south": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_bottom_s"}},
    {"when": {"type": "top",    "south": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_top_s"}},
    {"when": {"type": "double", "south": false}, "apply": {"model": "ncb_roadblck:block/asphalt_white_link_s"}},

    {"when": {"type": "bottom", "east": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_bottom_e"}},
    {"when": {"type": "top",    "east": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_top_e"}},
    {"when": {"type": "double", "east": false}, "apply": {"model": "ncb_roadblck:block/asphalt_white_link_e"}},

    {"when": {"type": "bottom", "west": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_bottom_w"}},
    {"when": {"type": "top",    "west": false}, "apply": {"model": "ncb_roadblck:block/asphalt_yellow_link_top_w"}},
    {"when": {"type": "double", "west": false}, "apply": {"model": "ncb_roadblck:block/asphalt_white_link_w"}}
  ]
}